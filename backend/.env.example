PORT=8080
CORS_ORIGINS=https://www.figimi.com,https://figimi.vercel.app,http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# 32-byte key, supplied as 64 hex characters or base64. Store in Google Secret Manager.
IPTV_CREDENTIALS_KEY=GENERATE_A_32_BYTE_SECRET
# Must match DeviceKey.SHARED_SECRET in the Android TV app. Rotating it invalidates every device key.
FIGIMI_DEVICE_KEY_SECRET=figimi-device-key-v1-shared-secret
